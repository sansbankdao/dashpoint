---
// src/components/TipSelector.astro
export interface Props {
    activeTip: number
}
const { activeTip } = Astro.props

const tips = [
    { label: 'Custom', value: 'custom' },
    { label: '0%', value: '0' },
    { label: '15%', value: '15' },
    { label: '18%', value: '18' },
    { label: '20%', value: '20' },
]
---
<div class="flex justify-between items-center mb-4">
    <span class="font-semibold">Tip</span>
    <div class="flex space-x-2">
        {tips.map(tip => (
            <button
                class:list={[
                    "tip-btn",
                    { "active": String(activeTip) === tip.value || (activeTip > 0 && tip.value === 'custom' && ![0, 15, 18, 20].includes(activeTip)) }
                ]}
                data-tip={tip.value}
            >
                {tip.label}
            </button>
        ))}
    </div>
</div>

<script>
// This script runs on the client to handle clicks and emit events
document.querySelector('.tip-btn')?.parentElement?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.matches('.tip-btn')) {
        const tipValue = target.dataset.tip;
        // Dispatch a custom event that the parent page can listen for
        const event = new CustomEvent('tipchange', {
            detail: { tip: tipValue },
            bubbles: true, // Allows the event to bubble up to the document
            composed: true
        });
        target.dispatchEvent(event);
    }
})
</script>
