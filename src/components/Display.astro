---
// src/components/Display.astro
---

<!--
    The mobile floor is zero on purpose. A 36vh minimum held the amount panel
    at 204px on a 568px-tall phone, which is taller than its contents, and it
    competed with the keypad for the single screen the terminal must occupy.
    Wide screens keep the taller panel; they have the room.
-->
<div class="w-full flex flex-col items-center justify-center min-h-0 sm:min-h-[30vh] md:min-h-0 p-2 sm:p-4">
    <!-- Currency -->
    <div class="text-slate-500 dark:text-slate-400 font-semibold text-lg mb-2" id="Currency">
        USD
    </div>

    <!-- Main Amount -->
    <div id="Amount"
         class="font-black text-center mb-2 leading-tight transition-all duration-200 text-4xl sm:text-5xl md:text-5xl lg:text-6xl tracking-tightest"
         style="line-height: 1;">
        $0.00
    </div>

    <!-- Total -->
    <div id="Total"
         class="font-black text-center mb-2 text-2xl transition-all duration-200 hidden">
        Total: $0.00
    </div>

    <!-- Calculation -->
    <div class="text-slate-500 dark:text-slate-400 text-center text-base mt-2" id="Calculation">

    </div>
</div>

<script>
    function formatCurrency(value: number, withSymbol = true): string {
        return (withSymbol ? '$' : '') + value.toLocaleString('en-US', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        })
    }

    const app = document.getElementById('pos-app')
    app?.addEventListener('stateupdate', (e: any) => {
        const state = e.detail

        document.getElementById('Currency')!.textContent = 'USD'

        const amountEl = document.getElementById('Amount')!
        /*
         * The display shows the running base plus the typed amount, matching
         * calculateTotal() on the page. baseAmount carries whatever was
         * accumulated with the + key, and it must be added here as well or the
         * headline would drop back to $0.00 after a + press.
         */
        const displayed = parseFloat(state.amountStr) / 100  // Convert cents to dollars
        const dollarsValue = (state.baseAmount || 0) + displayed
        amountEl.textContent = formatCurrency(dollarsValue)
        amountEl.style.fontSize = state.fontSize

        const totalEl = document.getElementById('Total')!
        const showTotal = state.total !== dollarsValue
        totalEl.classList.toggle('hidden', !showTotal)
        if (showTotal) {
            totalEl.textContent = `Total: ${formatCurrency(state.total)}`
            totalEl.style.fontSize = `${parseFloat(state.fontSize) / 3}px`
        }

        document.getElementById('Calculation')!.textContent = state.calculation
    })
</script>
