---
// src/components/Display.astro
export interface Props {
    total: number
    tipPercent: number
}

const { total, tipPercent } = Astro.props
---

<div class="text-center mb-4">
    <span class="text-slate-500 dark:text-slate-400">
        USD
    </span>

    <div id="total-display" class="text-6xl font-light tracking-tight">
        ${total.toFixed(2)}
    </div>

    <div class="text-sm text-slate-400 dark:text-slate-500 mt-1">
        <span id="tip-display">
            Tip: {tipPercent}%
        </span>
    </div>
</div>
