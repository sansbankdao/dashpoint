---
// src/components/ProductCard.astro
interface Props {
    id: number;
    title: string;
    price: number;
    imageUrl: string;
}

const { id, title, price, imageUrl } = Astro.props;
---
<button
    class="product-card border bg-white rounded-lg p-3 text-center flex flex-col items-center justify-between hover:shadow-lg hover:border-green-500 transition-all duration-200 cursor-pointer focus:outline-none focus:ring-2 focus:ring-green-500"
    data-id={id}
    data-price={price}
    data-title={title}
>
    <img src={imageUrl} alt={title} class="w-full h-24 object-contain mb-2" />
    <div>
        <p class="font-semibold text-gray-800">{title}</p>
        <p class="text-gray-600">${price.toFixed(2)}</p>
    </div>
</button>
