---
// src/components/ModeTabs.astro
---

<div id="ModeTablist" class="mode-tablist" role="tablist">
    <div class="d-flex gap-2">
        <!-- Amount Tab -->
        <div class="mode-tab-wrapper">
            <input
                id="ModeTablist-amounts"
                name="mode"
                value="amount"
                type="radio"
                role="tab"
                data-bs-target="#Mode-amount"
                aria-controls="Mode-amount"
                checked
                class="mode-input"
            >
            <label for="ModeTablist-amounts" class="btcpay-pill mode-label active">
                Amount
            </label>
        </div>

        <!-- Discount Tab -->
        <div class="mode-tab-wrapper">
            <input
                id="ModeTablist-discount"
                name="mode"
                value="discount"
                type="radio"
                role="tab"
                data-bs-target="#Mode-discount"
                aria-controls="Mode-discount"
                class="mode-input"
                disabled
            >
            <label for="ModeTablist-discount" class="btcpay-pill mode-label">
                Discount
            </label>
        </div>

        <!-- Tip Tab -->
        <div class="mode-tab-wrapper">
            <input
                id="ModeTablist-tip"
                name="mode"
                value="tip"
                type="radio"
                role="tab"
                data-bs-target="#Mode-tip"
                aria-controls="Mode-tip"
                class="mode-input"
                disabled
            >
            <label for="ModeTablist-tip" class="btcpay-pill mode-label">
                Tip
            </label>
        </div>
    </div>
</div>

<script>
    const app = document.getElementById('pos-app')
    const inputs = document.querySelectorAll('.mode-input') as NodeListOf<HTMLInputElement>
    const labels = document.querySelectorAll('.mode-label')

    inputs.forEach((input, index) => {
        input.addEventListener('change', () => {
            if (input.checked) {
                const mode = input.value as 'amount' | 'discount' | 'tip'
                app?.dispatchEvent(new CustomEvent('modechange', {
                    detail: { mode },
                    bubbles: true,
                    composed: true
                }))

                // Update visual states
                labels.forEach((label, i) => {
                    label.classList.toggle('active', i === index)
                    label.classList.toggle('disabled', i !== index)
                })
            }
        })
    })

    // Listen for state updates to enable/disable tabs
    app?.addEventListener('stateupdate', (e: any) => {
        const { hasBaseAmount } = e.detail
        const discountInput = document.getElementById('ModeTablist-discount') as HTMLInputElement
        const tipInput = document.getElementById('ModeTablist-tip') as HTMLInputElement
        const discountLabel = document.querySelector('[for="ModeTablist-discount"]')!
        const tipLabel = document.querySelector('[for="ModeTablist-tip"]')!

        const isEnabled = hasBaseAmount
        discountInput.disabled = !isEnabled
        tipInput.disabled = !isEnabled
        discountLabel.classList.toggle('disabled', !isEnabled)
        tipLabel.classList.toggle('disabled', !isEnabled)
    })
</script>

<style>
    .mode-tablist {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 0.75rem;
        padding-bottom: 0.25rem;
        gap: 0.5rem;
    }

    .mode-tab-wrapper {
        position: relative;
    }

    .mode-input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }
</style>
