---
// src/components/Storefront.astro
import ProductCard from './ProductCard.astro'

interface Product {
    id: number;
    title: string;
    price: number;
    imageUrl: string;
}

interface Props {
    products: Product[]
}

const { products } = Astro.props
---

<div class="min-h-screen flex items-center justify-center p-4">
    <div class="w-full max-w-md bg-gray-50 rounded-2xl shadow-xl overflow-hidden relative">
        <!-- Header -->
        <header class="text-center py-6 px-4 bg-white border-b">
            <img src="https://placehold.co/100x100/A7D397/424769/png?text=K" alt="Kombucha Logo" class="w-24 h-24 rounded-full mx-auto mb-4 border-2 border-gray-200">
            <h1 class="text-4xl font-bold text-gray-800">Kombucha</h1>
        </header>

        <!-- Product Grid -->
        <main class="p-4 grid grid-cols-3 gap-3">
            {products.map(product => (
                <ProductCard
                    id={product.id}
                    title={product.title}
                    price={product.price}
                    imageUrl={product.imageUrl}
                />
            ))}
        </main>

        <!-- Footer / Cart Summary -->
        <footer class="sticky bottom-0 bg-white border-t p-4 flex items-center justify-between">
            <div class="flex items-baseline gap-4">
                <span id="total-amount" class="text-3xl font-bold text-gray-900">$0.00</span>
                <span class="border rounded-md px-3 py-1 text-sm font-medium text-gray-600 bg-gray-100">USD</span>
            </div>
            <button id="pay-button" class="bg-green-500 text-white font-bold py-3 px-8 rounded-lg hover:bg-green-600 transition-colors disabled:bg-gray-300 disabled:cursor-not-allowed">
                Pay
            </button>
        </footer>
    </div>
</div>

<script>
interface ICartItem {
    id: number;
    title: string;
    price: number;
    amount: number;
}
// Simple in-memory cart
let cartTotal = 0.00;
const cartItems: ICartItem[] = []

// DOM Elements
const productCards = document.querySelectorAll('.product-card')
const totalAmountEl = document.getElementById('total-amount')
const payButton = document.getElementById('pay-button') as HTMLButtonElement

function updateTotalDisplay() {
    totalAmountEl!.textContent = `$${cartTotal.toFixed(2)}`
    payButton!.disabled = cartTotal === 0
}

function handleProductClick(event: MouseEvent) {
    const card = event.currentTarget as HTMLButtonElement

    if (card === null) return
    if (card.dataset === null) return

    const price = parseFloat(card.dataset.price!)
    const title = card.dataset.title!
    const id = parseInt(card.dataset.id!, 10)

    // Add to cart logic
    cartTotal += price;
    cartItems.push({ id, title, price } as ICartItem);

    // Update UI
    updateTotalDisplay();

    console.log('Cart:', cartItems);
    console.log('Total:', cartTotal.toFixed(2));
}

// Attach event listeners
productCards.forEach(card => {
    card.addEventListener('click', handleProductClick);
});

// Pay button functionality (for demonstration)
payButton.addEventListener('click', () => {
    if (cartTotal > 0) {
        alert(`Proceeding to pay $${cartTotal.toFixed(2)}\nItems: ${JSON.stringify(cartItems, null, 2)}`);
        // In a real app, this would redirect to a payment page (like BTCPay Server's invoice page)
    }
});

// Initial state
updateTotalDisplay();
</script>
