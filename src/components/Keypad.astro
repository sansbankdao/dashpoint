---
// src/components/Keypad.astro
---
<div id="keypad-container" class="grid grid-cols-3 gap-2 mb-4">
    {'123456789.0'.split('').map(key => (
        <button class="keypad-btn num-btn">{key}</button>
    ))}
    <button id="backspace-btn" class="keypad-btn flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2M3 12l6.414 6.414a2 2 0 002.828 0L21 12M3 12l6.414-6.414a2 2 0 012.828 0L21 12" />
        </svg>
    </button>
</div>

<script>
document.getElementById('keypad-container')?.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    let eventName: string | null = null;
    let detail: object | null = null;

    if (target.matches('.num-btn')) {
        eventName = 'keypad:input';
        detail = { key: target.textContent };
    } else if (target.closest('#backspace-btn')) {
        eventName = 'keypad:backspace';
        detail = {};
    }

    if (eventName) {
        const event = new CustomEvent(eventName, { detail, bubbles: true, composed: true });
        target.dispatchEvent(event);
    }
})
</script>
