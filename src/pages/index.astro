---
// src/pages/index.astro
import '../styles/global.css'

// Import the new components
import Display from '../components/Display.astro'
import TipSelector from '../components/TipSelector.astro'
import Keypad from '../components/Keypad.astro'

// The state is defined once at the top for Server-Side Rendering (SSR)
// It will be dynamically updated on the client via the script below.
let amountStr = '0'
let tipPercent = 0

function calculateTotal(amount: string, tip: number): number {
    const baseAmount = parseFloat(amount) || 0
    const total = baseAmount * (1 + tip / 100)
    return total
}
const initialTotal = calculateTotal(amountStr, tipPercent)
---

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />

	<title>DashPoint POS</title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>

<body class="bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 flex items-center justify-center min-h-screen">

<main id="pos-app" class="w-full max-w-sm mx-auto bg-white dark:bg-slate-800 rounded-lg shadow-xl p-6 font-sans">

	<!-- Components are placed here. Props are passed down. -->
	<Display total={initialTotal} tipPercent={tipPercent} />
	<TipSelector activeTip={tipPercent} />
	<Keypad />

	<!-- The Charge button remains here as it's the final action of the page -->
	<button id="charge-btn" class="w-full bg-green-600 hover:bg-green-700 text-white font-bold py-4 rounded-lg text-xl transition-colors">
		Charge
	</button>
</main>

<script>
// --- CLIENT-SIDE SCRIPT FOR INTERACTIVITY ---
// This single script on the main page manages all state.

// --- STATE ---
let amountStr = '0';
let tipPercent = 0;
let activeMode: 'amount' | 'tip' = 'amount';

// --- DOM ELEMENTS (for updating) ---
const totalDisplay = document.getElementById('total-display') as HTMLElement;
const tipDisplay = document.getElementById('tip-display') as HTMLElement;
const tipButtons = document.querySelectorAll('.tip-btn');

// --- LOGIC ---
function calculateTotal() {
	const baseAmount = parseFloat(amountStr) || 0;
	return baseAmount * (1 + tipPercent / 100);
}

function updateDOM() {
	const finalTotal = calculateTotal();
	totalDisplay.textContent = `$${finalTotal.toFixed(2)}`;
	tipDisplay.textContent = `Tip: ${tipPercent}%`;

	tipButtons.forEach(btn => {
		const button = btn as HTMLButtonElement;
		button.classList.remove('active');
		if (button.dataset.tip === String(tipPercent) || (tipPercent > 0 && button.dataset.tip === 'custom' && ![0, 15, 18, 20].includes(tipPercent))) {
			button.classList.add('active');
		} else if (tipPercent === 0 && button.dataset.tip === '0') {
			button.classList.add('active');
		}
	});
}

function handleNumberInput(key: string) {
	if (activeMode === 'amount') {
		if (key === '.' && amountStr.includes('.')) return;
		if (amountStr === '0' && key !== '.') amountStr = key;
		else {
			const decimalIndex = amountStr.indexOf('.');
			if (decimalIndex !== -1 && amountStr.length - decimalIndex > 2) return;
			amountStr += key;
		}
	} else if (activeMode === 'tip') {
		if (key === '.') return;
		const newTipStr = (tipPercent === 0 ? '' : String(tipPercent)) + key;
		tipPercent = parseInt(newTipStr, 10);
		if (tipPercent > 100) tipPercent = 100;
	}
	updateDOM();
}

function handleBackspace() {
	if (activeMode === 'amount') {
		amountStr = amountStr.length > 1 ? amountStr.slice(0, -1) : '0';
	} else if (activeMode === 'tip') {
		const tipStr = String(tipPercent);
		tipPercent = tipStr.length > 1 ? parseInt(tipStr.slice(0, -1), 10) : 0;
	}
	updateDOM();
}

// --- EVENT LISTENERS (listening for events from child components) ---
const app = document.getElementById('pos-app');

app?.addEventListener('keypad:input', (e: any) => handleNumberInput(e.detail.key));
app?.addEventListener('keypad:backspace', () => handleBackspace());

app?.addEventListener('tipchange', (e: any) => {
	const tipValue = e.detail.tip;
	if (tipValue === 'custom') {
		activeMode = 'tip';
		tipPercent = 0;
	} else {
		activeMode = 'amount';
		tipPercent = parseInt(tipValue!, 10);
	}
	updateDOM();
});

document.getElementById('charge-btn')?.addEventListener('click', () => {
	const finalTotal = calculateTotal();
	if (finalTotal <= 0) {
		alert("Please enter an amount.");
		return;
	}
	alert(`Charging a total of $${finalTotal.toFixed(2)}`);
	amountStr = '0';
	tipPercent = 0;
	activeMode = 'amount';
	updateDOM();
});
</script>
</body>
</html>
