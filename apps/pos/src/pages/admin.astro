---
// src/pages/admin.astro

import '../styles/global.css'
import { DEFAULT_CONFIG } from '../lib/config'

// Server-rendered defaults. Live values are hydrated from localStorage by the
// inline script below so the page works on a static host.
const defaults = DEFAULT_CONFIG

/*
 * The confirmation threshold is rendered as a STRING.
 *
 * Astro omits an attribute whose value is falsy, and the default threshold is
 * 0, so `value={defaults.confirmThresholdUsd}` produced an input with no value
 * attribute at all. The field then showed whatever the browser last had, and
 * an empty box on a fresh device. A string is never omitted, so "0" reaches
 * the page.
 */
const confirmThresholdValue = String(DEFAULT_CONFIG.confirmThresholdUsd)
---

<!DOCTYPE html>
<html lang="en" class="h-screen">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terminal Admin — PayMeDash POS</title>
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#2563eb" />
    <!-- The terminal is installable; start_url is /, not this page. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body class="min-h-dvh bg-gradient-to-br from-slate-50 via-blue-50 to-indigo-100 dark:from-slate-900 dark:via-slate-900 dark:to-indigo-950 text-slate-900 dark:text-slate-100 flex flex-col">
    <div id="admin-app" class="flex flex-col h-full min-h-screen">
        <!-- Header -->
        <header class="bg-white/90 dark:bg-slate-800/90 backdrop-blur-sm border-b border-slate-200 dark:border-slate-700 px-6 py-4 shadow-sm sticky top-0 z-50">
            <div class="max-w-2xl mx-auto flex items-center justify-between gap-4">
                <h1 class="text-2xl font-bold">Terminal Admin</h1>
                <a href="/" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline whitespace-nowrap">
                    &larr; Back to POS
                </a>
            </div>
        </header>

        <main class="flex-1 px-6 py-8">
            <form id="admin-form" class="max-w-2xl mx-auto flex flex-col gap-6" novalidate>
                <!-- Store identity -->
                <section class="bg-white/90 dark:bg-slate-800/90 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-6 flex flex-col gap-4">
                    <h2 class="text-lg font-semibold">Store</h2>

                    <div class="flex flex-col gap-1">
                        <label for="storeName" class="text-sm font-medium text-slate-600 dark:text-slate-300">Store name</label>
                        <input id="storeName" name="storeName" type="text" maxlength="64"
                            value={defaults.storeName}
                            class="rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500" />
                        <p class="text-xs text-slate-500 dark:text-slate-400">Shown in the POS header and footer.</p>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label for="currency" class="text-sm font-medium text-slate-600 dark:text-slate-300">Display currency</label>
                        <input id="currency" name="currency" type="text" maxlength="8"
                            value={defaults.currency}
                            class="rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500" />
                        <p class="text-xs text-slate-500 dark:text-slate-400">Label only. POS amounts are USD-denominated in this build.</p>
                    </div>

                    <div class="flex flex-col gap-1">
                        <label for="tipPresets" class="text-sm font-medium text-slate-600 dark:text-slate-300">Tip presets (%)</label>
                        <input id="tipPresets" name="tipPresets" type="text" maxlength="48"
                            value={defaults.tipPresets.join(', ')}
                            class="rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500" />
                        <p class="text-xs text-slate-500 dark:text-slate-400">Comma-separated whole numbers between 1 and 100.</p>
                    </div>
                </section>

                <!-- Install -->
                <section class="bg-white/90 dark:bg-slate-800/90 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-6 flex flex-col gap-3">
                    <h2 class="text-lg font-semibold">Install</h2>
                    <p class="text-xs text-slate-500 dark:text-slate-400">
                        Installing adds PayMeDash to this device's home screen, where it opens full-screen and
                        straight to the payment terminal.
                    </p>

                    <!-- Shown when the browser can prompt directly. -->
                    <button id="install-btn" type="button"
                        class="hidden self-start bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-bold py-3 px-6 rounded-xl shadow-lg transition-all duration-200">
                        Install PayMeDash to Home Screen
                    </button>

                    <!--
                        Shown when the browser cannot prompt directly. iOS Safari
                        has no install event, so the only route is the share
                        sheet, and the user has to be told the steps.
                    -->
                    <div id="install-hint" class="hidden rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 p-4 text-xs text-slate-600 dark:text-slate-300 flex-col gap-2">
                        <p class="font-semibold">To install on this device</p>
                        <p id="install-hint-ios" class="hidden">
                            Tap the Share button in Safari, then choose <strong>Add to Home Screen</strong>.
                        </p>
                        <p id="install-hint-generic" class="hidden">
                            Open this page in a browser menu and choose <strong>Install app</strong> or
                            <strong>Add to Home Screen</strong>.
                        </p>
                    </div>

                    <!-- Shown once the app is already running installed. -->
                    <p id="install-done" class="hidden text-xs font-medium text-emerald-600 dark:text-emerald-400">
                        PayMeDash is installed on this device.
                    </p>
                </section>

                <!-- Payouts -->
                <section class="bg-white/90 dark:bg-slate-800/90 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-6 flex flex-col gap-4">
                    <h2 class="text-lg font-semibold">Payouts</h2>

                    <div class="flex flex-col gap-1">
                        <label for="destinationAddress" class="text-sm font-medium text-slate-600 dark:text-slate-300">Your DASH payout address (this device)</label>
                        <input id="destinationAddress" name="destinationAddress" type="text" maxlength="48" spellcheck="false" autocomplete="off"
                            placeholder="X…"
                            value={defaults.destinationAddress}
                            class="rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-4 py-3 font-mono text-sm outline-none focus:ring-2 focus:ring-blue-500" />
                        <p id="destinationAddress-status" class="text-xs text-slate-500 dark:text-slate-400">Checked against the Dash address formats below.</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            Accepts a Dash Core (L1) P2PKH mainnet address. Platform (L2) addresses,
                            including shielded ones, are identified for you but cannot be saved here
                            yet.
                        </p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            Used for sales taken on this browser. This is the only place the payout address is
                            held: the API stores no address of its own, so a terminal with no value saved here
                            cannot take a payment. The address is sent with each sale and is never shown to the
                            customer.
                        </p>
                    </div>

                    <!-- Settlement -->
                    <div class="flex flex-col gap-1">
                        <label for="confirmThresholdUsd" class="text-sm font-medium text-slate-600 dark:text-slate-300">Wait for confirmation above</label>
                        <input id="confirmThresholdUsd" name="confirmThresholdUsd" type="text" inputmode="decimal" maxlength="12"
                            value={confirmThresholdValue}
                            class="rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-4 py-3 outline-none focus:ring-2 focus:ring-blue-500" />
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            A dollar figure. Sales at or below it complete as soon as the deposit is detected;
                            larger sales wait until the DASH payout is broadcast. Leave 0 to treat every sale as
                            settled on detection, which is the default.
                        </p>
                    </div>

                    <!-- Secret key handling -->
                    <div class="rounded-xl border border-amber-300 dark:border-amber-700 bg-amber-50 dark:bg-amber-950/40 p-4 flex flex-col gap-2">
                        <h3 class="text-sm font-semibold text-amber-900 dark:text-amber-200">Partner key</h3>
                        <p class="text-xs text-amber-900 dark:text-amber-200">
                            The 1Click partner JWT is stored server-side in Cloudflare Secrets Store and is never entered,
                            stored, or transmitted from this page. Quotes made through the API are authenticated
                            automatically. Do not paste the JWT into this admin page or into any file in this repository:
                            anything done in a browser is readable by whoever opens the page.
                        </p>
                        <p id="key-status" class="text-xs font-medium text-amber-900 dark:text-amber-200"></p>
                    </div>
                </section>

                <!-- Auto-shielding -->
                <section class="bg-white/90 dark:bg-slate-800/90 rounded-2xl border border-slate-200 dark:border-slate-700 shadow-sm p-6 flex flex-col gap-4">
                    <h2 class="text-lg font-semibold">Auto-shielding</h2>

                    <label for="autoShield" class="flex items-center gap-3 cursor-pointer select-none">
                        <input id="autoShield" name="autoShield" type="checkbox"
                            class="peer sr-only" />
                        <span
                            class="shrink-0 w-11 h-6 rounded-full bg-slate-300 dark:bg-slate-600 relative transition-colors
                                   after:content-[''] after:absolute after:top-0.5 after:left-0.5 after:w-5 after:h-5
                                   after:rounded-full after:bg-white after:shadow after:transition-transform
                                   peer-checked:bg-blue-600 peer-checked:after:translate-x-5
                                   peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500"></span>
                        <span class="text-sm font-medium">Automatically shield completed sales</span>
                    </label>

                    <div class="flex flex-col gap-1">
                        <label for="shieldAddress" class="text-sm font-medium text-slate-600 dark:text-slate-300">Your shielded payout address (Orchard)</label>
                        <input id="shieldAddress" name="shieldAddress" type="text" spellcheck="false" autocomplete="off"
                            placeholder="dash1z…"
                            value={defaults.shieldAddress}
                            class="rounded-xl border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-900 px-4 py-3 font-mono text-sm outline-none focus:ring-2 focus:ring-blue-500" />
                        <p id="shieldAddress-status" class="text-xs text-slate-500 dark:text-slate-400">Where the shielded balance is held.</p>
                        <p class="text-xs text-slate-500 dark:text-slate-400">
                            A Dash Platform Orchard address, shown by your Dash wallet when you create a
                            shielded balance. It starts with <span class="font-mono">dash1z</span>, unlike an
                            ordinary address that starts with <span class="font-mono">X</span>. It is required
                            when auto-shielding is on; the API decodes it fully before any shield is created.
                        </p>
                    </div>

                    <div class="rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 p-4 flex flex-col gap-2">
                        <p class="text-xs text-slate-600 dark:text-slate-300">
                            <span class="font-semibold">What this does:</span> when auto-shielding is on,
                            each sale is paid into a <span class="font-medium">fresh single-use deposit
                            address</span> instead of your visible payout address, and as soon as that
                            payment is confirmed the terminal automatically moves it into the
                            <span class="font-medium">Dash shielded pool</span>, to the Orchard address
                            above. After shielding, the payout amount and its destination are no longer
                            visible on the public chain as a plain payment to your address.
                        </p>
                        <p class="text-xs text-slate-600 dark:text-slate-300">
                            <span class="font-semibold">It is off by default.</span> Shielding takes a small
                            fee out of the sale and adds a short delay after the payment settles. Leave this
                            off if you prefer payouts that stay visible and instant.
                        </p>
                        <p class="text-xs text-slate-600 dark:text-slate-300">
                            <span class="font-semibold">Nothing is lost either way:</span> the deposit
                            address is controlled by a key held only on this device until the shield
                            succeeds. If the shielding service is unreachable or refuses a sale, the payout
                            simply stays at that deposit address and the terminal keeps retrying while it
                            is open; the sale itself completes as normal.
                        </p>
                        <p class="text-xs text-slate-600 dark:text-slate-300">
                            <span class="font-semibold">Requires a mainnet payment API.</span> If the API
                            behind this terminal is not configured for Dash mainnet, sales complete to your
                            payout address as normal and the register shows a notice — nothing is ever sent
                            to a testnet address.
                        </p>
                    </div>
                </section>

                <!-- Actions -->
                <div class="flex flex-col gap-3">
                    <div class="flex items-center gap-3">
                        <button id="save-btn" type="submit"
                            class="flex-1 bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-bold py-4 px-6 rounded-2xl text-lg shadow-xl active:translate-y-0.5 transition-all duration-200">
                            Save settings
                        </button>
                        <button id="reset-btn" type="button"
                            class="py-4 px-6 rounded-2xl font-semibold border-2 border-slate-300 dark:border-slate-600 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 transition-all duration-200">
                            Reset
                        </button>
                    </div>
                    <p id="status" role="status" aria-live="polite"
                        class="text-sm text-center min-h-[1.25rem] text-slate-500 dark:text-slate-400"></p>
                </div>
            </form>
        </main>

        <!-- Footer -->
        <footer class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-sm border-t border-slate-200 dark:border-slate-700 px-6 py-4 mt-auto">
            <div class="text-center text-sm text-slate-500 dark:text-slate-400">
                Display settings are stored in this browser only. Payment settings are stored on the server.
            </div>
        </footer>
    </div>

    <script>
        import { DEFAULT_CONFIG, loadConfig, saveConfig, clearConfig, isValidDashAddress, type PosConfig } from '../lib/config'
        import { classifyDashAddress } from '../lib/address'

        const API_BASE = '/v1'

        const form = document.getElementById('admin-form') as HTMLFormElement
        const statusEl = document.getElementById('status')!
        const keyStatusEl = document.getElementById('key-status')!
        const saveBtn = document.getElementById('save-btn') as HTMLButtonElement
        const resetBtn = document.getElementById('reset-btn') as HTMLButtonElement
        const installBtn = document.getElementById('install-btn') as HTMLButtonElement
        const installHint = document.getElementById('install-hint')!
        const installHintIos = document.getElementById('install-hint-ios')!
        const installHintGeneric = document.getElementById('install-hint-generic')!
        const installDone = document.getElementById('install-done')!
        const autoShieldEl = document.getElementById('autoShield') as HTMLInputElement

        // `apiKey` is intentionally absent: the partner JWT is a server-side
        // secret and this page never reads or writes it.
        const fields: Array<keyof PosConfig> = [
            'storeName',
            'currency',
            'tipPresets',
            'destinationAddress',
            'shieldAddress',
            'confirmThresholdUsd'
        ]

        function inputFor(name: keyof PosConfig): HTMLInputElement {
            return document.getElementById(name) as HTMLInputElement
        }

        function setStatus(message: string, tone: 'ok' | 'error' | 'muted' = 'muted') {
            statusEl.textContent = message
            statusEl.className = 'text-sm text-center min-h-[1.25rem] ' + (
                tone === 'ok'
                    ? 'text-green-600 dark:text-green-400'
                    : tone === 'error'
                        ? 'text-red-600 dark:text-red-400'
                        : 'text-slate-500 dark:text-slate-400'
            )
        }

        function setAddressStatus(message: string, tone: 'ok' | 'error' | 'muted') {
            const el = document.getElementById('destinationAddress-status')!
            el.textContent = message
            el.className = 'text-xs ' + (
                tone === 'ok'
                    ? 'text-green-600 dark:text-green-400'
                    : tone === 'error'
                        ? 'text-red-600 dark:text-red-400'
                        : 'text-slate-500 dark:text-slate-400'
            )
        }

        function fillForm(config: PosConfig) {
            inputFor('storeName').value = config.storeName
            inputFor('currency').value = config.currency
            inputFor('tipPresets').value = config.tipPresets.join(', ')
            inputFor('destinationAddress').value = config.destinationAddress
            inputFor('shieldAddress').value = config.shieldAddress
            inputFor('confirmThresholdUsd').value = String(config.confirmThresholdUsd)
            autoShieldEl.checked = config.autoShield
        }

        function parseTipPresets(raw: string): number[] | null {
            const trimmed = raw.trim()
            if (!trimmed) return null

            const parts = trimmed.split(',').map(part => part.trim()).filter(Boolean)
            const numbers: number[] = []

            for (const part of parts) {
                if (!/^\d+$/.test(part)) return null
                const value = Number(part)
                if (value < 1 || value > 100) return null
                numbers.push(value)
            }

            return numbers.length ? numbers : null
        }

        /*
         * Parse the confirmation threshold.
         *
         * 0 is a real setting here (do not wait), NOT an empty one, so an empty
         * box is read as 0 and an unparsable box is refused rather than
         * silently coerced: a clerk who types "$/5" must be told, because the
         * alternative is a terminal quietly waiting for the wrong sales.
         */
        function parseThresholdUsd(raw: string): number | null {
            const trimmed = raw.trim()
            if (!trimmed) return 0
            if (!/^\d+(\.\d{1,2})?$/.test(trimmed)) return null
            const value = Number(trimmed)
            if (!Number.isFinite(value) || value < 0) return null
            return value
        }

        function setShieldAddressStatus(message: string, tone: 'ok' | 'error' | 'muted') {
            const el = document.getElementById('shieldAddress-status')!
            el.textContent = message
            el.className = 'text-xs ' + (
                tone === 'ok'
                    ? 'text-green-600 dark:text-green-400'
                    : tone === 'error'
                        ? 'text-red-600 dark:text-red-400'
                        : 'text-slate-500 dark:text-slate-400'
            )
        }

        function readForm(): PosConfig | null {
            const tipPresets = parseTipPresets(inputFor('tipPresets').value)
            if (!tipPresets) {
                setStatus('Tip presets must be comma-separated whole numbers between 1 and 100.', 'error')
                return null
            }

            const confirmThresholdUsd = parseThresholdUsd(inputFor('confirmThresholdUsd').value)
            if (confirmThresholdUsd === null) {
                setStatus('The confirmation threshold must be a dollar amount, for example 50 or 12.50.', 'error')
                return null
            }

            return {
                storeName: inputFor('storeName').value.trim() || DEFAULT_CONFIG.storeName,
                currency: inputFor('currency').value.trim().toUpperCase() || DEFAULT_CONFIG.currency,
                tipPresets,
                destinationAddress: inputFor('destinationAddress').value.trim(),
                shieldAddress: inputFor('shieldAddress').value.trim(),
                confirmThresholdUsd,
                autoShield: autoShieldEl.checked,
                // The JWT is never read from this page. Carrying the stored
                // value through unchanged keeps the previous behaviour of the
                // config object without ever surfacing it in the UI.
                refundAddress: DEFAULT_CONFIG.refundAddress,
                apiKey: DEFAULT_CONFIG.apiKey
            }
        }

        async function validateAddress(): Promise<boolean> {
            const value = inputFor('destinationAddress').value.trim()

            if (!value) {
                setAddressStatus('Checked against the Dash address formats below.', 'muted')
                return true
            }

            /*
             * Two questions, two answers.
             *
             * `classifyDashAddress` NAMES the address so the merchant is told
             * what they pasted — L1 Core, L2 Platform transparent, or L2
             * shielded. `isValidDashAddress` remains the gate: it is the one
             * the payment path has always used, and it accepts ONLY a mainnet
             * P2PKH address. Both run, so the message can be specific without
             * widening what may be saved.
             */
            const classification = await classifyDashAddress(value)
            const accepted = await isValidDashAddress(value)

            if (classification.kind === 'unknown') {
                setAddressStatus('Not a Dash address.', 'error')
                return false
            }

            if (accepted) {
                setAddressStatus(`${classification.label} — valid.`, 'ok')
                return true
            }

            /*
             * A real Dash address this screen still cannot use. Say which kind
             * it is and why it is refused, rather than calling a valid address
             * invalid.
             */
            const networkNote = classification.network === 'mainnet'
                ? ''
                : ' It is also not on mainnet.'

            setAddressStatus(
                `${classification.label}, but this field accepts only a Dash Core (L1) P2PKH mainnet address.${networkNote}`,
                'error'
            )
            return false
        }

        /*
         * Check the Orchard address shape.
         *
         * A full bech32m decode is deliberately NOT attempted here: this file
         * has no decoder, and the payment API decodes the address
         * authoritatively when a shield is created, refusing a malformed one
         * with a 400 before anything is signed. What IS checked locally is
         * the network prefix and the bech32 character set, so an obviously
         * wrong paste is caught at the counter before a sale is ever taken.
         * The length window brackets the real thing (the known-good mainnet
         * vector is 82 characters) without hard-coding a payload layout this
         * page has no reason to know.
         */
        const ORCHARD_RE = /^(tdash|dash)1z[qpzry9x8gf2tvdw0s3jn54khce6mua7l]+$/

        function validateShieldAddress(): boolean {
            const value = inputFor('shieldAddress').value.trim()

            if (!autoShieldEl.checked) {
                // The field is only meaningful with auto-shielding on.
                if (!value) {
                    setShieldAddressStatus('Where the shielded balance is held.', 'muted')
                    return true
                }
            }

            if (!value) {
                setShieldAddressStatus('Required: auto-shielding needs an Orchard address to pay into.', 'error')
                return false
            }

            if (!ORCHARD_RE.test(value) || value.length < 70 || value.length > 100) {
                setShieldAddressStatus(
                    'Not an Orchard address shape. It starts with dash1z (mainnet) or tdash1z (testnet).',
                    'error'
                )
                return false
            }

            if (value.startsWith('tdash1z')) {
                setShieldAddressStatus(
                    'Testnet Orchard address — sales deliver mainnet DASH, so a mainnet (dash1z…) address is required.',
                    'error'
                )
                return false
            }

            setShieldAddressStatus('Orchard address shape OK. The API decodes it fully when shielding.', 'ok')
            return true
        }

        // Report whether the deployed API has a partner key bound, without
        // revealing it. /v1/health exposes only a boolean.
        async function reportKeyStatus() {
            try {
                const response = await fetch(`${API_BASE}/health`)
                const data = await response.json()
                keyStatusEl.textContent = data.partnerKeyPresent
                    ? 'Partner key is configured on the server. Quotes are authenticated.'
                    : 'No partner key configured on the server. Quotes use the public schedule.'
            } catch {
                keyStatusEl.textContent = 'Could not reach the API to check the partner key.'
            }
        }

        form.addEventListener('submit', async (event) => {
            event.preventDefault()

            const config = readForm()
            if (!config) return

            if (!(await validateAddress())) {
                setStatus('Fix the highlighted address before saving.', 'error')
                return
            }

            if (!validateShieldAddress()) {
                setStatus('Fix the shielded payout address, or turn auto-shielding off.', 'error')
                return
            }

            if (!saveConfig(config)) {
                setStatus('Could not save: browser storage is unavailable.', 'error')
                return
            }

            fillForm(config)
            setStatus('Settings saved.', 'ok')
        })

        resetBtn.addEventListener('click', () => {
            clearConfig()
            fillForm({ ...DEFAULT_CONFIG })
            setAddressStatus('Checked against the Dash address formats below.', 'muted')
            setShieldAddressStatus('Where the shielded balance is held.', 'muted')
            setStatus('Settings reset to defaults.', 'ok')
        })

        // Live re-validation as the operator types.
        {
            const input = inputFor('destinationAddress')
            let timer: number | undefined
            input.addEventListener('input', () => {
                if (timer) window.clearTimeout(timer)
                /*
                 * Delegates to `validateAddress` rather than repeating its
                 * logic. The two used to hold separate copies of the wording,
                 * which is how a single address could be described two
                 * different ways depending on whether it was typed or saved.
                 */
                timer = window.setTimeout(() => { void validateAddress() }, 250)
            })
        }

        // Same for the Orchard address: shape-check while typing, never while
        // the operator is mid-paste on a slow device.
        {
            const input = inputFor('shieldAddress')
            let timer: number | undefined
            input.addEventListener('input', () => {
                if (timer) window.clearTimeout(timer)
                timer = window.setTimeout(() => { validateShieldAddress() }, 250)
            })
        }

        // --- INSTALL ---
        //
        // "Install PayMeDash to Home Screen".
        //
        // Only Chromium browsers fire beforeinstallprompt, and only when the
        // manifest, service worker, and secure-origin requirements are met, so
        // the event is captured when it arrives and its prompt is deferred until
        // the operator clicks. Every other browser, iOS Safari in particular,
        // has no programmatic install at all: there the button is replaced by
        // the steps for the share sheet, because a button that cannot do
        // anything is worse than an instruction that can be followed.
        type InstallPrompt = Event & { prompt(): Promise<void>; userChoice: Promise<{ outcome: string }> }
        let deferredInstallPrompt: InstallPrompt | null = null

        /* Show the hint, choosing the wording for this browser. */
        function showInstallHint() {
            const ua = navigator.userAgent
            const isIos = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1)
            const isSafari = isIos && !/CriOS|FxiOS|EdgiOS/.test(ua)

            installHint.classList.remove('hidden')
            installHint.classList.add('flex')
            /* iOS Safari has no install event, so it always gets the steps. */
            installHintIos.classList.toggle('hidden', !isSafari)
            installHintGeneric.classList.toggle('hidden', isSafari)
        }

        /*
         * True when this page is already running as an installed app.
         *
         * display-mode standalone is the modern signal; navigator.standalone is
         * the iOS-specific one, and iOS does not report display-mode reliably.
         */
        function isInstalled() {
            return window.matchMedia('(display-mode: standalone)').matches
                || (navigator as unknown as { standalone?: boolean }).standalone === true
        }

        function refreshInstallUi() {
            if (isInstalled()) {
                installBtn.classList.add('hidden')
                installHint.classList.add('hidden')
                installHint.classList.remove('flex')
                installDone.classList.remove('hidden')
                return
            }
            installDone.classList.add('hidden')
            if (deferredInstallPrompt) {
                /* A real prompt is available, so offer the real button. */
                installBtn.classList.remove('hidden')
                installHint.classList.add('hidden')
                installHint.classList.remove('flex')
            } else {
                installBtn.classList.add('hidden')
                showInstallHint()
            }
        }

        window.addEventListener('beforeinstallprompt', (event) => {
            /* Suppress the browser's own mini-infobar so the page controls it. */
            event.preventDefault()
            deferredInstallPrompt = event as InstallPrompt
            refreshInstallUi()
        })

        window.addEventListener('appinstalled', () => {
            deferredInstallPrompt = null
            refreshInstallUi()
            setStatus('PayMeDash was installed to the home screen.', 'ok')
        })

        installBtn.addEventListener('click', async () => {
            if (!deferredInstallPrompt) return
            const prompt = deferredInstallPrompt
            /*
             * An install prompt is single-use, so it is cleared before awaiting
             * the choice: a second click must not replay a spent event.
             */
            deferredInstallPrompt = null
            await prompt.prompt()
            const choice = await prompt.userChoice
            if (choice.outcome !== 'accepted') {
                /* Declined installs can still be offered again on a later visit. */
                refreshInstallUi()
            }
        })

        // The POS page registers the service worker; this page only needs the
        // manifest to be reachable, which the link tag above provides.
        refreshInstallUi()

        // Hydrate from localStorage on load.
        fillForm(loadConfig())
        void reportKeyStatus()
    </script>
</body>
</html>