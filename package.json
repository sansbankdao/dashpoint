{
  "name": "paymedash",
  "version": "0.1.0",
  "private": true,
  "description": "PayMeDash — landing page, demo storefront, hosted storefront and point-of-sale.",
  "author": "Sansbank contributors <hello@sansbank.org>",
  "license": "MIT",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @paymedash/web dev",
    "dev:store": "pnpm --filter @paymedash/store dev",
    "dev:pos": "pnpm --filter @paymedash/pos dev",

    "build:web": "pnpm --filter @paymedash/web build",
    "build:store": "pnpm --filter @paymedash/store build",
    "build:pos": "pnpm --filter @paymedash/pos build",
    "build": "pnpm -r build",

    "check": "pnpm -r check",
    "test": "pnpm -r test",
    "audit": "pnpm -r audit"
  }
}
